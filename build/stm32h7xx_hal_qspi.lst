 163:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****     =============================================
 164:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****     [..]
 165:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       The compilation define  USE_HAL_QSPI_REGISTER_CALLBACKS when set to 1
 166:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       allows the user to configure dynamically the driver callbacks.
 167:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c **** 
 168:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       Use Functions HAL_QSPI_RegisterCallback() to register a user callback,
 169:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       it allows to register following callbacks:
 170:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) ErrorCallback : callback when error occurs.
 171:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) AbortCpltCallback : callback when abort is completed.
 172:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) FifoThresholdCallback : callback when the fifo threshold is reached.
 173:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) CmdCpltCallback : callback when a command without data is completed.
 174:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) RxCpltCallback : callback when a reception transfer is completed.
 175:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) TxCpltCallback : callback when a transmission transfer is completed.
 176:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) StatusMatchCallback : callback when a status match occurs.
 177:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) TimeOutCallback : callback when the timeout perioed expires.
 178:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) MspInitCallback    : QSPI MspInit.
 179:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) MspDeInitCallback  : QSPI MspDeInit.
 180:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       This function takes as parameters the HAL peripheral handle, the Callback ID
 181:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       and a pointer to the user callback function.
 182:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c **** 
 183:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       Use function HAL_QSPI_UnRegisterCallback() to reset a callback to the default
 184:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       weak (surcharged) function. It allows to reset following callbacks:
 185:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) ErrorCallback : callback when error occurs.
 186:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) AbortCpltCallback : callback when abort is completed.
 187:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) FifoThresholdCallback : callback when the fifo threshold is reached.
 188:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) CmdCpltCallback : callback when a command without data is completed.
 189:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) RxCpltCallback : callback when a reception transfer is completed.
 190:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) TxCpltCallback : callback when a transmission transfer is completed.
 191:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) StatusMatchCallback : callback when a status match occurs.
 192:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) TimeOutCallback : callback when the timeout perioed expires.
 193:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) MspInitCallback    : QSPI MspInit.
 194:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****         (+) MspDeInitCallback  : QSPI MspDeInit.
 195:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       This function) takes as parameters the HAL peripheral handle and the Callback ID.
 196:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c **** 
 197:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       By default, after the HAL_QSPI_Init and if the state is HAL_QSPI_STATE_RESET
 198:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       all callbacks are reset to the corresponding legacy weak (surcharged) functions.
 199:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       Exception done for MspInit and MspDeInit callbacks that are respectively
 200:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       reset to the legacy weak (surcharged) functions in the HAL_QSPI_Init
 201:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       and  HAL_QSPI_DeInit only when these callbacks are null (not registered beforehand).
 202:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       If not, MspInit or MspDeInit are not null, the HAL_QSPI_Init and HAL_QSPI_DeInit
ARM GAS  C:\Users\HUAV\AppData\Local\Temp\ccXnwCGo.s 			page 5


 203:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       keep and use the user MspInit/MspDeInit callbacks (registered beforehand)
 204:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c **** 
 205:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       Callbacks can be registered/unregistered in READY state only.
 206:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       Exception done for MspInit/MspDeInit callbacks that can be registered/unregistered
 207:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       in READY or RESET state, thus registered (user) MspInit/DeInit callbacks can be used
 208:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       during the Init/DeInit.
 209:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       In that case first register the MspInit/MspDeInit user callbacks
 210:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       using HAL_QSPI_RegisterCallback before calling HAL_QSPI_DeInit
 211:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       or HAL_QSPI_Init function.
 212:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c **** 
 213:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       When The compilation define USE_HAL_QSPI_REGISTER_CALLBACKS is set to 0 or
 214:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       not defined, the callback registering feature is not available
 215:HW_Lib/STM32H7/HAL_Lib/STM32H7xx_HAL_Driver/Src/stm32h7xx_hal_qspi.c ****       and weak (surcharged) callbacks are used.
