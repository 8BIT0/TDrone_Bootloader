 138:HW_Lib/STM32H7/HAL_Lib/Core/Src/system_stm32h7xx.c **** /* This variable is updated in three ways:
 139:HW_Lib/STM32H7/HAL_Lib/Core/Src/system_stm32h7xx.c ****     1) by calling CMSIS function SystemCoreClockUpdate()
 140:HW_Lib/STM32H7/HAL_Lib/Core/Src/system_stm32h7xx.c ****     2) by calling HAL API function HAL_RCC_GetHCLKFreq()
 141:HW_Lib/STM32H7/HAL_Lib/Core/Src/system_stm32h7xx.c ****     3) each time HAL_RCC_ClockConfig() is called to configure the system clock frequency
 142:HW_Lib/STM32H7/HAL_Lib/Core/Src/system_stm32h7xx.c ****        Note: If you use this function to configure the system clock; then there
 143:HW_Lib/STM32H7/HAL_Lib/Core/Src/system_stm32h7xx.c ****              is no need to call the 2 first functions listed above, since SystemCoreClock
 144:HW_Lib/STM32H7/HAL_Lib/Core/Src/system_stm32h7xx.c ****              variable is updated automatically.
 145:HW_Lib/STM32H7/HAL_Lib/Core/Src/system_stm32h7xx.c **** */
 146:HW_Lib/STM32H7/HAL_Lib/Core/Src/system_stm32h7xx.c **** uint32_t SystemCoreClock = 64000000;
 147:HW_Lib/STM32H7/HAL_Lib/Core/Src/system_stm32h7xx.c **** uint32_t SystemD2Clock = 64000000;
