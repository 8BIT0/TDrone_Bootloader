 100:System/FreeRTOS/portable/MemMang/heap_4.c **** /* Keeps track of the number of calls to allocate and free memory as well as the
 101:System/FreeRTOS/portable/MemMang/heap_4.c **** number of free bytes remaining, but says nothing about fragmentation. */
 102:System/FreeRTOS/portable/MemMang/heap_4.c **** static size_t xFreeBytesRemaining = 0U;
 103:System/FreeRTOS/portable/MemMang/heap_4.c **** static size_t xMinimumEverFreeBytesRemaining = 0U;
 104:System/FreeRTOS/portable/MemMang/heap_4.c **** static size_t xNumberOfSuccessfulAllocations = 0;
 105:System/FreeRTOS/portable/MemMang/heap_4.c **** static size_t xNumberOfSuccessfulFrees = 0;
