  28:System/FreeRTOS/portable/MemMang/heap_4.c **** /*
  29:System/FreeRTOS/portable/MemMang/heap_4.c ****  * A sample implementation of pvPortMalloc() and vPortFree() that combines
  30:System/FreeRTOS/portable/MemMang/heap_4.c ****  * (coalescences) adjacent memory blocks as they are freed, and in so doing
  31:System/FreeRTOS/portable/MemMang/heap_4.c ****  * limits memory fragmentation.
  32:System/FreeRTOS/portable/MemMang/heap_4.c ****  *
  33:System/FreeRTOS/portable/MemMang/heap_4.c ****  * See heap_1.c, heap_2.c and heap_3.c for alternative implementations, and the
  34:System/FreeRTOS/portable/MemMang/heap_4.c ****  * memory management pages of http://www.FreeRTOS.org for more information.
  35:System/FreeRTOS/portable/MemMang/heap_4.c ****  */
  36:System/FreeRTOS/portable/MemMang/heap_4.c **** #include <stdlib.h>
  37:System/FreeRTOS/portable/MemMang/heap_4.c **** 
  38:System/FreeRTOS/portable/MemMang/heap_4.c **** /* Defining MPU_WRAPPERS_INCLUDED_FROM_API_FILE prevents task.h from redefining
  39:System/FreeRTOS/portable/MemMang/heap_4.c **** all the API functions to use the MPU wrappers.  That should only be done when
  40:System/FreeRTOS/portable/MemMang/heap_4.c **** task.h is included from an application file. */
  41:System/FreeRTOS/portable/MemMang/heap_4.c **** #define MPU_WRAPPERS_INCLUDED_FROM_API_FILE
  42:System/FreeRTOS/portable/MemMang/heap_4.c **** 
  43:System/FreeRTOS/portable/MemMang/heap_4.c **** #include "FreeRTOS.h"
  44:System/FreeRTOS/portable/MemMang/heap_4.c **** #include "task.h"
  45:System/FreeRTOS/portable/MemMang/heap_4.c **** 
  46:System/FreeRTOS/portable/MemMang/heap_4.c **** #undef MPU_WRAPPERS_INCLUDED_FROM_API_FILE
  47:System/FreeRTOS/portable/MemMang/heap_4.c **** 
  48:System/FreeRTOS/portable/MemMang/heap_4.c **** #if( configSUPPORT_DYNAMIC_ALLOCATION == 0 )
  49:System/FreeRTOS/portable/MemMang/heap_4.c **** 	#error This file must not be used if configSUPPORT_DYNAMIC_ALLOCATION is 0
  50:System/FreeRTOS/portable/MemMang/heap_4.c **** #endif
  51:System/FreeRTOS/portable/MemMang/heap_4.c **** 
  52:System/FreeRTOS/portable/MemMang/heap_4.c **** /* Block sizes must not get too small. */
  53:System/FreeRTOS/portable/MemMang/heap_4.c **** #define heapMINIMUM_BLOCK_SIZE	( ( size_t ) ( xHeapStructSize << 1 ) )
  54:System/FreeRTOS/portable/MemMang/heap_4.c **** 
