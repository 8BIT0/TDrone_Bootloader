  58:System/FreeRTOS/portable/MemMang/heap_4.c **** /* Allocate the memory for the heap. */
  59:System/FreeRTOS/portable/MemMang/heap_4.c **** #if( configAPPLICATION_ALLOCATED_HEAP == 1 )
  60:System/FreeRTOS/portable/MemMang/heap_4.c **** 	/* The application writer has already defined the array used for the RTOS
  61:System/FreeRTOS/portable/MemMang/heap_4.c **** 	heap - probably so it can be placed in a special segment or address. */
  62:System/FreeRTOS/portable/MemMang/heap_4.c **** 	extern uint8_t ucHeap[ configTOTAL_HEAP_SIZE ];
  63:System/FreeRTOS/portable/MemMang/heap_4.c **** #else
